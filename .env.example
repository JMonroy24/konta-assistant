# Entorno General
ENVIRONMENT=development
PORT=8080

# CouchDB Configuración
COUCHDB_USER=admin
COUCHDB_PASSWORD=adminsecretpassword
COUCHDB_REMOTE_URL=http://localhost:5984
COUCHDB_LOCAL_URL=http://localhost:5985

# Mock Ministerio de Hacienda
MOCK_HACIENDA_URL=http://localhost:8081

# JWT y Seguridad
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars!
TOKEN_EXPIRATION_HOURS=24

# Control X0 (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=konta_control_x0
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/konta_control_x0
