{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocumentoDeclaracion",
  "type": "object",
  "required": ["_id", "tipo", "periodo", "tipo_impuesto", "montos_calculados", "estado"],
  "properties": {
    "_id": { "type": "string" },
    "_rev": { "type": "string" },
    "tipo": { "type": "string", "enum": ["declaracion"] },
    "periodo": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "tipo_impuesto": { "type": "string" },
    "montos_calculados": { "type": "object" },
    "estado": { "type": "string", "enum": ["borrador", "presentada"] },
    "fecha_presentacion": { "type": ["string", "null"], "format": "date-time" }
  }
}
