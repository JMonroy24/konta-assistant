{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Declaracion",
  "type": "object",
  "required": [
    "_id",
    "tipo",
    "periodo",
    "tipo_impuesto",
    "montos_calculados",
    "estado",
    "fecha_presentacion"
  ],
  "properties": {
    "_id": { "type": "string" },
    "_rev": { "type": "string" },
    "tipo": { "type": "string" },
    "periodo": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
    "tipo_impuesto": {
      "type": "string",
      "enum": ["iva_f07", "pago_cuenta_f14", "renta_f11"]
    },
    "montos_calculados": { "type": "object" },
    "estado": { "type": "string", "enum": ["borrador", "presentada"] },
    "fecha_presentacion": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
